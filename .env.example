# ─── GG environment ──────────────────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit a filled .env.
# Every variable used by any app/package is listed here (docs/ARCHITECTURE.md §1).

# Runtime environment: development | staging | production
NODE_ENV=development

# ─── Web (apps/web) ──────────────────────────────────────────────────────────
# Port the Next.js server listens on.
WEB_PORT=3000
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── API (apps/api) ──────────────────────────────────────────────────────────
# Port the Fastify API listens on.
API_PORT=4000
# Comma-separated browser origins allowed by CORS. The genznewz.com origin is
# used ONLY by the embeddable debate widget (no cookies cross origins, §9.3).
CORS_ORIGINS=https://gg.genznewz.com,https://genznewz.com,http://localhost:3000

# Session cookie signing secret (long random string; rotate on compromise).
SESSION_SECRET=
# JWT signing secret for API/OIDC tokens (long random string).
JWT_SECRET=

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres 17 (pgvector) connection string.
DATABASE_URL=postgres://gg:gg@localhost:5432/gg

# ─── Redis ───────────────────────────────────────────────────────────────────
# Cache, BullMQ queues, rate limits, realtime backplane.
REDIS_URL=redis://localhost:6379

# ─── Object storage (S3-compatible: R2 / S3) ─────────────────────────────────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=gg-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Product policy (docs/DECISIONS.md) ──────────────────────────────────────
# Weight of an AI-agent vote relative to a human vote. D-012: 1.0 = equal.
AGENT_VOTE_WEIGHT=1.0
# Minimum age to register. D-011: 13.
MIN_AGE=13

# ─── AI providers (provider-agnostic layer; all optional in Phase 0) ────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Worker (apps/worker) ────────────────────────────────────────────────────
# BullMQ queue name prefix / concurrency can be tuned per environment.
WORKER_CONCURRENCY=5
